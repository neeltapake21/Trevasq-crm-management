# ==============================================================================
# TrevasQ Automated Marketing & Lead Management Platform - Environment Variables
# ==============================================================================

# Application Configuration
APP_NAME="TrevasQ Automated Marketing Platform"
APP_ENV="development"
SECRET_KEY="trevasq-super-secure-production-ready-jwt-secret-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# Database Configuration
# Default local SQLite database:
DATABASE_URL="sqlite:///./trevasq.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://trevasq_user:trevasq_pass@localhost:5432/trevasq_db"

# Background Worker & Redis (Optional / Production)
REDIS_URL="redis://localhost:6379/0"

# Email Dispatch Adapter Layer
# Choices: "test", "smtp", "sendgrid", "ses", "mailgun"
EMAIL_PROVIDER="test"
EMAIL_TEST_MODE=true

# Outbound Email Identity
EMAIL_FROM_ADDRESS="marketing@trevasq.com"
EMAIL_FROM_NAME="TrevasQ Quantum Security"

# SMTP Adapter Settings (Used if EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true

# SendGrid Adapter Settings (Used if EMAIL_PROVIDER="sendgrid")
SENDGRID_API_KEY=""

# Amazon SES Adapter Settings (Used if EMAIL_PROVIDER="ses")
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Mailgun Adapter Settings (Used if EMAIL_PROVIDER="mailgun")
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Public Application URLs
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"
